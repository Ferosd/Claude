        "sendTo": "={{ $json.email }}",
        "subject": "=Thank You for Your Interest!",
        "message": "=<div style='font-family: Arial, sans-serif; \n     max-width: 600px; margin: 0 auto; \n     background: #060a0e;'>\n\n  <div style='background: #00D4AA; \n       padding: 40px 30px; text-align: center;'>\n    <h1 style='margin: 0; color: #060a0e; font-size: 26px;'>\n      Message Received!\n    </h1>\n    <p style='margin: 8px 0 0; color: #060a0e; opacity: 0.8;'>\n      We'll get back to you within 24 hours.\n    </p>\n  </div>\n\n  <div style='background: #0d1317; padding: 30px;'>\n    <p style='color: #F0F4F3;'>\n      Hi {{ ($json.contactName || 'there').split(' ')[0] }},\n    </p>\n    <p style='color: #F0F4F3; line-height: 1.7;'>\n      Thank you for reaching out to Coremagna! \n      We've received your inquiry and our team \n      will be in touch within 24 hours.\n    </p>\n\n    <div style='background: #111920; \n         border-left: 4px solid #00D4AA;\n         padding: 20px; margin: 25px 0;\n         border-radius: 0 8px 8px 0;'>\n      <h3 style='color: #00D4AA; margin-top: 0;'>\n        Your Inquiry Summary\n      </h3>\n      <p style='color: #F0F4F3; margin: 6px 0;'>\n        <strong style='color:#00D4AA'>Service:</strong> \n        {{ $json.Service }}\n      </p>\n      <p style='color: #F0F4F3; margin: 6px 0;'>\n        <strong style='color:#00D4AA'>Budget:</strong> \n        {{ $json.budgetRange }}\n      </p>\n      <p style='color: #F0F4F3; margin: 6px 0;'>\n        <strong style='color:#00D4AA'>Timeline:</strong> \n        {{ $json.timeline }}\n      </p>\n    </div>\n\n    <p style='color: #F0F4F3; line-height: 1.7;'>\n      In the meantime, feel free to book a call \n      directly if you'd like to speak sooner:\n    </p>\n\n    <div style='text-align: center; margin: 24px 0;'>\n      <a href='https://calendar.app.google/XDGM8XJ9zEdqugKr9'\n         style='background: #00D4AA; color: #060a0e;\n                padding: 12px 28px; text-decoration: none;\n                border-radius: 8px; font-weight: 700;\n                font-size: 15px;'>\n        📅 Book a Strategy Call\n      </a>\n    </div>\n\n    <p style='color: #F0F4F3; line-height: 1.7;'>\n      We look forward to helping your business grow!\n    </p>\n\n    <p style='color: #F0F4F3; margin-top: 24px;'>\n      Best regards,<br>\n      <strong style='color: #00D4AA;'>Ferit</strong><br>\n      <span style='color: #6B8A8A;'>Coremagna</span>\n    </p>\n  </div>\n\n  <div style='background: #111920; padding: 16px; \n       text-align: center;'>\n    <p style='margin: 0; color: #6B8A8A; font-size: 13px;'>\n      📧 ferit1@coremagna.com &nbsp;·&nbsp; \n      🌐 coremagna.com &nbsp;·&nbsp; \n      Mon–Fri 9am–6pm CET\n    </p>\n  </div>\n\n</div>",
        "options": {}
