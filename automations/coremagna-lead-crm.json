{
  "name": "Real-time lead qualification, scoring & CRM integration system using Jotform",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this lead using the BANT framework and provide \ncomprehensive qualification for Coremagna, a digital agency \noffering web design, AI chatbots, and automation services.\n\nLEAD INFORMATION:\nName: {{ $json.contactName }}\nCompany: {{ $json.companyName }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\nService Interest: {{ $json.Service }}\nBudget Range: {{ $json.budgetRange }}\nTimeline: {{ $json.timeline }}\nMessage / Pain Points: {{ $json.Message }}\n\nBudget scoring guide for Coremagna services:\n- €10,000+ → budget score 25 (Hot)\n- €3,000–€10,000 → budget score 18 (Warm)\n- €1,000–€3,000 → budget score 10 (Cold)\n- Under €1,000 → budget score 5 (Unqualified)\n\nTimeline scoring guide:\n- As soon as possible → timeline score 25\n- Within 1 month → timeline score 20\n- 1–3 months → timeline score 12\n- Just exploring → timeline score 5\n\nProvide analysis in JSON format:\n{\n  \"leadScore\": 0-100,\n  \"qualificationTier\": \"Hot/Warm/Cold/Unqualified\",\n  \"bant\": {\n    \"budget\": {\n      \"score\": 0-25,\n      \"assessment\": \"description\",\n      \"hasBudget\": true/false\n    },\n    \"authority\": {\n      \"score\": 0-25,\n      \"assessment\": \"description\",\n      \"decisionMaker\": true/false\n    },\n    \"need\": {\n      \"score\": 0-25,\n      \"assessment\": \"description\",\n      \"painSeverity\": \"low/medium/high/critical\"\n    },\n    \"timeline\": {\n      \"score\": 0-25,\n      \"assessment\": \"description\",\n      \"urgency\": \"immediate/1-3months/3-6months/6+months\"\n    }\n  },\n  \"keyInsights\": [\"insight1\", \"insight2\"],\n  \"redFlags\": [\"flag1\", \"flag2\"],\n  \"opportunitySize\": \"small/medium/large/enterprise\",\n  \"recommendedAction\": \"immediate call/email nurture/demo/disqualify\",\n  \"conversionProbability\": \"0-100%\",\n  \"estimatedDealValue\": \"€ amount or range\",\n  \"nextSteps\": [\"step1\", \"step2\", \"step3\"],\n  \"talkingPoints\": [\"point1\", \"point2\", \"point3\"]\n}\n\nIMPORTANT: Respond ONLY with the JSON object. No markdown, \nno explanations. Raw JSON only.",
        "options": {
          "systemMessage": "You are an expert B2B sales qualification analyst specializing in BANT methodology. Provide objective, data-driven lead assessments that help sales teams prioritize and convert opportunities effectively."
        }
      },
      "id": "8bfc82f4-b5b0-4aaf-93f0-e8f2c6b97c14",
      "name": "AI Lead Scoring (BANT)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        -1520,
        144
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\n\n// Strip markdown code fences if the model wraps the JSON\nconst cleaned = String(raw).replace(/```json\\n?|\\n?```/g, '').trim();\n\nconst joinList = v => Array.isArray(v) ? v.join(' | ') : (v == null ? '' : String(v));\n\nlet p = null;\ntry {\n  p = JSON.parse(cleaned);\n} catch (e) {\n  p = null;\n}\n\n// Fallback: never lose the lead just because scoring failed — route it for manual review\nif (!p || typeof p !== 'object') {\n  return [{\n    json: {\n      leadScore: 50,\n      qualificationTier: 'Warm',\n      'Key Findings': 'AI scoring could not be parsed — review this lead manually',\n      'Red Flags': 'AI scoring failed',\n      Status: 'Warm',\n      keyInsights: 'AI scoring could not be parsed — review this lead manually',\n      nextSteps: 'Review lead details and call back manually',\n      budget_score: 0,\n      authority_score: 0,\n      need_score: 0,\n      timeline_score: 0,\n      recommendedAction: 'manual review',\n      conversionProbability: '',\n      estimatedDealValue: ''\n    }\n  }];\n}\n\nconst bant = p.bant || {};\nconst sub = k => (bant[k] && typeof bant[k] === 'object') ? bant[k] : {};\n\nreturn [{\n  json: {\n    leadScore: Number(p.leadScore) || 0,\n    qualificationTier: p.qualificationTier || 'Cold',\n    'Key Findings': joinList(p.keyInsights),\n    'Red Flags': joinList(p.redFlags),\n    Status: p.qualificationTier || 'Cold',\n    keyInsights: joinList(p.keyInsights),\n    nextSteps: joinList(p.nextSteps),\n    budget_score: Number(sub('budget').score) || 0,\n    authority_score: Number(sub('authority').score) || 0,\n    need_score: Number(sub('need').score) || 0,\n    timeline_score: Number(sub('timeline').score) || 0,\n    recommendedAction: joinList(p.recommendedAction),\n    conversionProbability: joinList(p.conversionProbability),\n    estimatedDealValue: joinList(p.estimatedDealValue)\n  }\n}];"
      },
      "id": "c6ca6126-7265-4813-a116-b96f476c0b9c",
      "name": "Parse Lead Score",
      "type": "n8n-nodes-base.code",
      "position": [
        -1216,
        128
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const salesTeam = {\n  senior: [\n    {\n      name: \"Ferit\",\n      email: \"ferit1@coremagna.com\",\n      territory: [\"All\"],\n      industries: [\"All\"],\n      minDealSize: 0,\n      currentLeads: 0\n    }\n  ],\n  midLevel: [\n    {\n      name: \"Emma\",\n      email: \"emma@coremagna.com\",\n      territory: [\"All\"],\n      industries: [\"All\"],\n      minDealSize: 0,\n      currentLeads: 0\n    }\n  ],\n  sdr: [\n    {\n      name: \"Adrien\",\n      email: \"adrien@coremagna.com\",\n      territory: [\"All\"],\n      industries: [\"All\"],\n      minDealSize: 0,\n      currentLeads: 0\n    }\n  ]\n};\n\nconst leadData = $input.first().json;\nconst leadScore = Number(leadData.leadScore) || 0;\nconst qualificationTier = leadData.qualificationTier;\n\nlet repLevel;\nif (leadScore >= 75) {\n  repLevel = 'senior';\n} else if (leadScore >= 50) {\n  repLevel = 'midLevel';\n} else {\n  repLevel = 'sdr';\n}\n\nconst assignedRep = salesTeam[repLevel][0];\n\nconst output = {\n  assignedRepName: assignedRep.name,\n  assignedRepEmail: assignedRep.email,\n  repLevel: repLevel,\n  assignmentReason: `Lead score: ${leadScore}/100 — Tier: ${qualificationTier}`,\n  routingTimestamp: new Date().toISOString(),\n  ...leadData,\n  ...$('Extract Lead Data1').first().json\n};\n\nreturn { json: output };"
      },
      "id": "16696d9e-ff22-4745-9d3f-22554aa83ce7",
      "name": "Intelligent Routing Logic",
