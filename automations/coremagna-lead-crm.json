        -1040,
        80
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "sendTo": "={{ $json.assignedRepEmail }}",
        "subject": "=🔥 {{ $json.qualificationTier }} Lead Assigned: {{ $json.companyName }} (Score: {{ $json.leadScore }})",
        "message": "=<div style='font-family: Cabinet Grotesk, Arial, sans-serif; \n     max-width: 700px; margin: 0 auto; background: #060a0e;'>\n\n  <div style='background: #00D4AA; padding: 30px;'>\n    <h1 style='margin: 0; color: #060a0e; font-size: 22px;'>\n      🎯 New {{ $json.qualificationTier }} Lead — {{ $json.leadScore }}/100\n    </h1>\n    <p style='margin: 8px 0 0; color: #060a0e; opacity: 0.8;'>\n      {{ $json.routingTimestamp }}\n    </p>\n  </div>\n\n  <div style='background: #0d1317; padding: 25px; \n       border-left: 4px solid #00D4AA;'>\n    <h2 style='color: #00D4AA; margin-top: 0;'>Lead Information</h2>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Name:</strong> {{ $json.contactName }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Company:</strong> {{ $json.companyName }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Email:</strong> {{ $json.email }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Phone:</strong> {{ $json.phone }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Service Interest:</strong> {{ $json.Service }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Budget:</strong> {{ $json.budgetRange }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Timeline:</strong> {{ $json.timeline }}\n    </p>\n    <p style='color: #F0F4F3;'>\n      <strong style='color:#00D4AA'>Message:</strong> {{ $json.Message }}\n    </p>\n  </div>\n\n  <div style='background: #111920; padding: 25px;'>\n    <h2 style='color: #00D4AA; margin-top: 0;'>BANT Breakdown</h2>\n    <table style='width:100%; border-collapse: collapse;'>\n      <tr>\n        <td style='color:#F0F4F3; padding: 8px 0; \n            border-bottom: 1px solid #0d1317;'>\n          <strong style='color:#00D4AA'>Budget</strong>\n        </td>\n        <td style='color:#F0F4F3; padding: 8px 0; \n            border-bottom: 1px solid #0d1317; text-align:right;'>\n          {{ $json.budget_score }}/25\n        </td>\n      </tr>\n      <tr>\n        <td style='color:#F0F4F3; padding: 8px 0; \n            border-bottom: 1px solid #0d1317;'>\n          <strong style='color:#00D4AA'>Authority</strong>\n        </td>\n        <td style='color:#F0F4F3; padding: 8px 0; \n            border-bottom: 1px solid #0d1317; text-align:right;'>\n          {{ $json.authority_score }}/25\n        </td>\n      </tr>\n      <tr>\n        <td style='color:#F0F4F3; padding: 8px 0; \n            border-bottom: 1px solid #0d1317;'>\n          <strong style='color:#00D4AA'>Need</strong>\n        </td>\n        <td style='color:#F0F4F3; padding: 8px 0; \n            border-bottom: 1px solid #0d1317; text-align:right;'>\n          {{ $json.need_score }}/25\n        </td>\n      </tr>\n      <tr>\n        <td style='color:#F0F4F3; padding: 8px 0;'>\n          <strong style='color:#00D4AA'>Timeline</strong>\n        </td>\n        <td style='color:#F0F4F3; padding: 8px 0; text-align:right;'>\n          {{ $json.timeline_score }}/25\n        </td>\n      </tr>\n    </table>\n  </div>\n\n  <div style='background: #0d1317; padding: 20px; \n       border-left: 4px solid #00D4AA; margin-top: 2px;'>\n    <h3 style='color: #00D4AA; margin-top: 0;'>AI Analysis</h3>\n    <p style='color:#F0F4F3;'>\n      <strong style='color:#00D4AA'>Tier:</strong> \n      {{ $json.qualificationTier }}\n    </p>\n    <p style='color:#F0F4F3;'>\n      <strong style='color:#00D4AA'>Conversion Probability:</strong> \n      {{ $json.conversionProbability }}\n    </p>\n    <p style='color:#F0F4F3;'>\n      <strong style='color:#00D4AA'>Estimated Deal Value:</strong> \n      {{ $json.estimatedDealValue }}\n    </p>\n    <p style='color:#F0F4F3;'>\n      <strong style='color:#00D4AA'>Recommended Action:</strong> \n      {{ $json.recommendedAction }}\n    </p>\n  </div>\n\n  <div style='background: #111920; padding: 20px; margin-top: 2px;'>\n    <h3 style='color: #00D4AA; margin-top: 0;'>Key Insights</h3>\n    <p style='color: #F0F4F3; line-height: 1.6;'>\n      {{ $json.keyInsights }}\n    </p>\n  </div>\n\n  <div style='background: #0d1317; padding: 20px; margin-top: 2px;'>\n    <h3 style='color: #00D4AA; margin-top: 0;'>Next Steps</h3>\n    <p style='color: #F0F4F3; line-height: 1.6;'>\n      {{ $json.nextSteps }}\n    </p>\n  </div>\n\n  <div style='background: #00D4AA; padding: 16px; text-align: center;'>\n    <p style='margin: 0; color: #060a0e; font-size: 13px;'>\n      <strong>Coremagna</strong> · ferit1@coremagna.com · coremagna.com\n    </p>\n  </div>\n\n</div>",
        "options": {}
      },
